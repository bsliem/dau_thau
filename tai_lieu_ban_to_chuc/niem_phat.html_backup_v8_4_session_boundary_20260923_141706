    <style>
        :root {
            --primary: #b96d08;
            --primary-light: #e79a21;
            --background: #f4efe5;
            --card: #fffdf8;
            --text: #32291f;
            --secondary: #8a7967;
            --border: #e9dfd0;
            --danger: #c94a42;
        }

        * {
            box-sizing: border-box;
            -webkit-tap-highlight-color: transparent;
        }

        html, body {
            margin: 0;
            min-height: 100%;
            background: var(--background);
        }


// ============================================================
// VALID RESPIRATORY EVENT
// ============================================================

function isRespiratoryEvent(event) {

    if (event.voided === true) {
        return false;
    }

    if (
        event.action === "breath_chant_cycle" &&
        Number(event.amount) === 1
    ) {
        return true;
    }

    if (
        event.action === "breath" &&
        Number(event.amount) === 1
    ) {
        return true;
    }

    if (
        event.action === "chant" &&
        Number(event.amount) === 1
    ) {
        return true;
    }

    return false;
}

// ============================================================
// UNDO
// ============================================================

function undo() {

    if (data.today <= 0) {
        return;
    }

    data.today -= 1;

    if (data.total > 0) {
        data.total -= 1;
    }

    for (
        let i = data.events.length - 1;
        i >= 0;
        i--
    ) {

        const event =
            data.events[i];

        if (
            event.voided === true
        ) {
            continue;
        }

        if (
            isRespiratoryEvent(event)
        ) {

            event.voided = true;
            event.void_reason = "manual_undo";
            event.voided_timestamp_ms = Date.now();

            break;
        }
    }

    logEvent(
        "undo",
        -1,
        false
    );

    saveData();
    updateDisplay();
}


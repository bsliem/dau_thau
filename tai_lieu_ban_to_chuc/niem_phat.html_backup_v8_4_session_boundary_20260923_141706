// ============================================================

function updateLiveSessionStats() {

    const now = new Date();

    // Current time ALWAYS runs
    if (currentClockEl) {

        currentClockEl.textContent =
            formatClockTime(now);
    }

    const session =
        getCurrentLiveSession();

    // Session finished / inactive
    if (!session.active) {

        if (currentSessionCountEl) {
            currentSessionCountEl.textContent = "0";
        }

        if (currentSessionRateEl) {
            currentSessionRateEl.textContent = "—";
        }

        if (currentSessionDurationEl) {
            currentSessionDurationEl.textContent = "00:00";
        }

        return;
    }

    // Active session
    if (currentSessionCountEl) {

        currentSessionCountEl.textContent =
            session.count
                .toLocaleString("zh-Hant");
    }

    if (currentSessionRateEl) {

        currentSessionRateEl.textContent =
            Number.isFinite(session.rate)
                ? session.rate.toFixed(1)
                : "—";
    }

    if (currentSessionDurationEl) {

        currentSessionDurationEl.textContent =
            formatSessionDuration(
                session.elapsed_s
            );
    }
}


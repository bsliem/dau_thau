const STUDY_START_DATE = "2026-09-23";

const QC_SESSION_GAP_S = SESSION_FALLBACK_GAP_S;

// Relative QC based on recent clean respiratory cycles
const QC_LOCAL_WINDOW = 7;

// Very short interval relative to local breathing
const QC_SHORT_RATIO = 0.50;

// Long interval suggesting missed chant / interruption
const QC_LONG_RATIO = 1.80;

// Absolute technical protection only
const QC_ABSOLUTE_MIN_S = 0.70;


function applyResearchQC(rows) {

    const breathRows = rows.filter(
        row =>
            row.action_normalized === "breath_chant_cycle" &&
            row.voided !== true
    );

    let previousEligible = null;
    let sessionNumber = 0;
    let currentDate = '';
    let cleanIntervals = [];

    breathRows.forEach(
        row => {

            // ------------------------------------------------
            // Study eligibility
            // ------------------------------------------------

            const correctDate =
                row.date >= STUDY_START_DATE;

            const correctAction =
                row.action === "breath_chant_cycle" ||
                row.action === "breath";

            const correctVersion =
                row.app_version ===
                    "v6_breath_chant_research" ||
                row.app_version ===
                    "v7_breath_chant_qc";

            row.study_eligible =
                (
                    correctDate &&
                    correctAction &&
                    correctVersion
                )
                    ? 1
                    : 0;

            if (!row.study_eligible) {

                row.analysis_valid = 0;
                row.exclusion_reason = "pre_study_or_legacy";
                row.exclude_from_resp_analysis = 1;

                return;
            }


            // ------------------------------------------------
            // New calendar day
            // ------------------------------------------------

            if (row.date !== currentDate) {

                currentDate = row.date;
                sessionNumber = 0;
                previousEligible = null;
                cleanIntervals = [];

            }


            // ------------------------------------------------
            // Gap from previous valid study marker
            // ------------------------------------------------

            let gap = null;

            if (
                previousEligible &&
                Number.isFinite(row.timestamp_ms) &&
                Number.isFinite(previousEligible.timestamp_ms)
            ) {

                gap =
                    (
                        row.timestamp_ms -
                        previousEligible.timestamp_ms
                    ) / 1000;

            }

            row.qc_gap_prev_marker_s = gap;


            // ------------------------------------------------
            // First event or long interruption = new session
            // ------------------------------------------------

            if (
                previousEligible === null ||
                gap === null ||
                gap >= getDynamicSessionThreshold(cleanIntervals)
            ) {

                sessionNumber++;

                row.qc_session_id =
                    `${row.date}_QCS${String(sessionNumber).padStart(2,'0')}`;

                row.qc_session_start = 1;

                row.analysis_valid = 0;

                row.exclude_from_resp_analysis = 1;

                row.exclusion_reason =
                    previousEligible === null
                        ? "session_start"
                        : "long_interruption_new_session";

                row.clean_respiratory_cycle_s = null;
                row.clean_respiratory_rate_bpm = null;

                row.local_median_cycle_s = null;
                row.cycle_ratio_local = null;
                row.suspected_missed_cycles = null;

                cleanIntervals = [];

                previousEligible = row;

                return;

            }


            row.qc_session_id =
                `${row.date}_QCS${String(sessionNumber).padStart(2,'0')}`;

            row.qc_session_start = 0;


            // ------------------------------------------------
            // Local median from recent CLEAN cycles
            // ------------------------------------------------

            const recent =
                cleanIntervals.slice(
                    -QC_LOCAL_WINDOW
                );

            const localMedian =
                recent.length >= 3
                    ? median(recent)
                    : null;

            row.local_median_cycle_s =
                localMedian;

            const ratio =
                (
                    localMedian &&
                    localMedian > 0
                )
                    ? gap / localMedian
                    : null;

            row.cycle_ratio_local = ratio;


            // ------------------------------------------------
            // QC decision
            // ------------------------------------------------

            let valid = true;
            let reason = "valid";


            // Technical impossible / accidental double tap
            if (
                gap < QC_ABSOLUTE_MIN_S
            ) {

                valid = false;
                reason = "possible_double_tap";

            }


            // Compare with established local rhythm
            if (
                valid &&
                localMedian !== null
            ) {

                if (
                    ratio < QC_SHORT_RATIO
                ) {

                    valid = false;
                    reason = "unexpectedly_short_interval";

                } else if (
                    ratio > QC_LONG_RATIO
                ) {

                    valid = false;
                    reason = "possible_missed_cycles";

                }

            }


            // ------------------------------------------------
            // Estimate how many cycles may have been missed
            // descriptive only -- NEVER imputed into analysis
            // ------------------------------------------------

            if (
                reason ===
                    "possible_missed_cycles" &&
                localMedian &&
                localMedian > 0
            ) {

                row.suspected_missed_cycles =
                    Math.max(
                        1,
                        Math.round(
                            gap / localMedian
                        ) - 1
                    );

            } else {

                row.suspected_missed_cycles = 0;

            }


            // ------------------------------------------------
            // Final clean analysis variables
            // ------------------------------------------------

            row.analysis_valid =
                valid ? 1 : 0;

            row.exclude_from_resp_analysis =
                valid ? 0 : 1;

            row.exclusion_reason =
                reason;

            if (valid) {

                row.clean_respiratory_cycle_s =
                    gap;

                row.clean_respiratory_rate_bpm =
                    60 / gap;

                cleanIntervals.push(
                    gap
                );

            } else {

                row.clean_respiratory_cycle_s =
                    null;

                row.clean_respiratory_rate_bpm =
                    null;

            }

            previousEligible = row;

        }
    );


    // ========================================================
    // CLEAN SESSION SUMMARY
    // ========================================================

    const sessionGroups = {};

    breathRows.forEach(
        row => {

            if (
                !row.study_eligible ||
                !row.qc_session_id
            ) {
                return;
            }

            if (!sessionGroups[row.qc_session_id]) {
                sessionGroups[row.qc_session_id] = [];
            }

            sessionGroups[row.qc_session_id].push(row);

        }
    );

    Object.keys(sessionGroups).forEach(
        id => {

            const group =
                sessionGroups[id];

            const cleanCycles =
                group
                    .filter(
                        r =>
                            r.analysis_valid === 1
                    )
                    .map(
                        r =>
                            r.clean_respiratory_cycle_s
                    )
                    .filter(Number.isFinite);

            const cleanRR =
                group
                    .filter(
                        r =>
                            r.analysis_valid === 1
                    )
                    .map(
                        r =>
                            r.clean_respiratory_rate_bpm
                    )
                    .filter(Number.isFinite);

            const stats =
                intervalStats(cleanCycles);

            const excludedN =
                group.filter(
                    r =>
                        r.analysis_valid === 0
                ).length;

            group.forEach(
                row => {

                    row.qc_session_total_markers =
                        group.length;

                    row.qc_session_valid_intervals =
                        cleanCycles.length;

                    row.qc_session_excluded_intervals =
                        excludedN;

                    row.qc_session_mean_cycle_s =
                        stats.mean;

                    row.qc_session_median_cycle_s =
                        stats.median;

                    row.qc_session_sd_cycle_s =
                        stats.sd;

                    row.qc_session_cv_cycle_pct =
                        stats.cv_pct;

                    row.qc_session_rmssd_cycle_s =
                        stats.rmssd;

                    row.qc_session_mean_rr_bpm =
                        mean(cleanRR);

                    row.qc_session_median_rr_bpm =
                        median(cleanRR);

                    row.qc_session_sd_rr_bpm =
                        sampleSD(cleanRR);

                }
            );

        }
    );


    // ========================================================
    // CLEAN DAILY SUMMARY
    // ========================================================

    const dayGroups = {};

    breathRows.forEach(
        row => {

            if (!row.study_eligible) {
                return;
            }

            if (!dayGroups[row.date]) {
                dayGroups[row.date] = [];
            }

            dayGroups[row.date].push(row);

        }
    );

    Object.keys(dayGroups).forEach(
        date => {

            const group =
                dayGroups[date];

            const cleanCycles =
                group
                    .filter(
                        r =>
                            r.analysis_valid === 1
                    )
                    .map(
                        r =>
                            r.clean_respiratory_cycle_s
                    )
                    .filter(Number.isFinite);

            const cleanRR =
                group
                    .filter(
                        r =>
                            r.analysis_valid === 1
                    )
                    .map(
                        r =>
                            r.clean_respiratory_rate_bpm
                    )
                    .filter(Number.isFinite);

            const stats =
                intervalStats(cleanCycles);

            const excluded =
                group.filter(
                    r =>
                        r.analysis_valid === 0
                ).length;

            const sessions =
                [
                    ...new Set(
                        group
                            .map(
                                r =>
                                    r.qc_session_id
                            )
                            .filter(Boolean)
                    )
                ];

            group.forEach(
                row => {

                    row.qc_day_total_markers =
                        group.length;

                    row.qc_day_valid_intervals =
                        cleanCycles.length;

                    row.qc_day_excluded_intervals =
                        excluded;

                    row.qc_day_sessions =
                        sessions.length;

                    row.qc_day_mean_cycle_s =
                        stats.mean;

                    row.qc_day_median_cycle_s =
                        stats.median;

                    row.qc_day_sd_cycle_s =
                        stats.sd;

                    row.qc_day_cv_cycle_pct =
                        stats.cv_pct;

                    row.qc_day_rmssd_cycle_s =
                        stats.rmssd;

                    row.qc_day_mean_rr_bpm =
                        mean(cleanRR);

                    row.qc_day_median_rr_bpm =
                        median(cleanRR);

                    row.qc_day_sd_rr_bpm =
                        sampleSD(cleanRR);

                }
            );

        }
    );

    return rows;

}



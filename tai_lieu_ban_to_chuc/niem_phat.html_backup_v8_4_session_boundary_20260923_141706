// ============================================================
// NORMALIZE
// ============================================================

function normalizeEvents() {

    return data.events
        .map(
            (event, index) => {

                const timestampMs =
                    Number(
                        event.timestamp_ms ??
                        event.timestamp
                    );

                const dt =
                    Number.isFinite(timestampMs)
                        ? new Date(timestampMs)
                        : null;

                const parts =
                    dt
                        ? getDateParts(dt)
                        : null;

                return {

                    ...event,

                    source_index:
                        index,

                    event_id:
                        event.event_id ||
                        `legacy_${index + 1}`,

                    app_version:
                        event.app_version ||
                        "legacy",

                    protocol_id:
                        event.protocol_id ||
                        PROTOCOL_ID,

                    measurement_type:
                        event.measurement_type ||
                        MEASUREMENT_TYPE,

                    chant_phrase:
                        event.chant_phrase ||
                        CHANT_PHRASE,

                    inspiration_phrase:
                        event.inspiration_phrase ||
                        INSPIRATION_PHRASE,

                    transition_phrase:
                        event.transition_phrase ||
                        TRANSITION_PHRASE,

                    expiration_phrase:
                        event.expiration_phrase ||
                        EXPIRATION_PHRASE,

                    tap_phase:
                        event.tap_phase ||
                        TAP_PHASE,

                    cycle_definition:
                        event.cycle_definition ||
                        CYCLE_DEFINITION,

                    timestamp_ms:
                        timestampMs,

                    date:
                        event.date ||
                        (parts ? parts.date : ""),

                    time:
                        event.time ||
                        (parts ? parts.time : ""),

                    datetime:
                        event.datetime ||
                        (parts ? parts.datetime : ""),

                    timezone_offset_min:
                        event.timezone_offset_min ??
                        (
                            dt
                                ? -dt.getTimezoneOffset()
                                : ""
                        ),

                    hour:
                        event.hour ??
                        (parts ? parts.hour : ""),

                    minute:
                        event.minute ??
                        (parts ? parts.minute : ""),

                    second:
                        event.second ??
                        (parts ? parts.second : ""),

                    weekday:
                        event.weekday ||
                        (
                            parts
                                ? getWeekdayEnglish(
                                    parts.weekday_num
                                )
                                : ""
                        ),

                    weekday_num:
                        event.weekday_num ??
                        (
                            parts
                                ? parts.weekday_num
                                : ""
                        ),

                    voided:
                        event.voided === true

                };

            }
        )
        .sort(
            (a, b) =>
                a.timestamp_ms -
                b.timestamp_ms
        );
}

// ============================================================
// INTERVAL STATS
// ============================================================

function intervalStats(intervals) {

    const x =
        intervals.filter(
            Number.isFinite
        );

    const m =
        mean(x);

    const q25 =
        quantile(x, 0.25);

    const q75 =
        quantile(x, 0.75);

    return {

        n:
            x.length,

        mean:
            m,

        median:
            median(x),

        sd:
            sampleSD(x),

        cv_pct:
            coefficientVariationPct(x),

        rmssd:
            rmssd(x),

        mean_abs_successive_diff:
            meanAbsoluteSuccessiveDifference(x),

        min:
            x.length
                ? Math.min(...x)
                : null,

        max:
            x.length
                ? Math.max(...x)
                : null,

        q10:
            quantile(x, 0.10),

        q25:
            q25,

        q75:
            q75,

        q90:
            quantile(x, 0.90),

        iqr:
            (
                q25 !== null &&
                q75 !== null
            )
                ? q75 - q25
                : null,

        rr_from_mean_cycle_bpm:
            (m && m > 0)
                ? 60 / m
                : null

    };
}

// ============================================================
// BUILD RESEARCH ROWS
// ============================================================

function buildResearchRows() {

    const allEvents =
        normalizeEvents();

    const breaths =
        allEvents.filter(
            isRespiratoryEvent
        );

    let previousBreath = null;
    let previousCycleS = null;
    let previousRR = null;

    let globalCycleIndex = 0;
    let dayCycleIndex = 0;
    let currentDate = "";

    let sessionNumberToday = 0;
    let sessionCycleIndex = 0;
    let sessionId = "";

    const sessionIntervals = {};
    const sessionRR = {};

    breaths.forEach(
        row => {

            globalCycleIndex++;

            if (
                row.date !==
                currentDate
            ) {

                currentDate = row.date;
                dayCycleIndex = 0;
                sessionNumberToday = 0;
            }

            dayCycleIndex++;

            let gapS = null;

            if (
                previousBreath &&
                Number.isFinite(
                    row.timestamp_ms
                ) &&
                Number.isFinite(
                    previousBreath.timestamp_ms
                )
            ) {

                gapS =
                    (
                        row.timestamp_ms -
                        previousBreath.timestamp_ms
                    ) / 1000;

            }

            const newSession =
                (
                    !previousBreath ||
                    previousBreath.date !== row.date ||
                    gapS === null ||
                    gapS >= getDynamicSessionThreshold((sessionIntervals[sessionId] || []))
                );

            if (newSession) {

                sessionNumberToday++;

                sessionId =
                    `${row.date}_S${pad2(sessionNumberToday)}`;

                sessionCycleIndex = 1;
                previousCycleS = null;
                previousRR = null;

                sessionIntervals[sessionId] = [];
                sessionRR[sessionId] = [];

            } else {

                sessionCycleIndex++;
            }

            row.global_cycle_index =
                globalCycleIndex;

            row.day_cycle_index =
                dayCycleIndex;

            row.session_id =
                sessionId;

            row.session_number_today =
                sessionNumberToday;

            row.session_cycle_index =
                sessionCycleIndex;

            row.session_start =
                newSession ? 1 : 0;

            row.gap_prev_marker_s =
                gapS;

            const cycleS =
                newSession
                    ? null
                    : gapS;

            row.respiratory_cycle_s =
                cycleS;

            row.respiratory_rate_bpm =
                (
                    cycleS &&
                    cycleS > 0
                )
                    ? 60 / cycleS
                    : null;

            row.cycle_change_s =
                (
                    cycleS !== null &&
                    previousCycleS !== null
                )
                    ? cycleS - previousCycleS
                    : null;

            row.abs_cycle_change_s =
                row.cycle_change_s !== null
                    ? Math.abs(
                        row.cycle_change_s
                    )
                    : null;

            row.cycle_change_pct =
                (
                    cycleS !== null &&
                    previousCycleS !== null &&
                    previousCycleS !== 0
                )
                    ? (
                        (
                            cycleS - previousCycleS
                        ) /
                        previousCycleS *
                        100
                    )
                    : null;

            row.rr_change_bpm =
                (
                    row.respiratory_rate_bpm !== null &&
                    previousRR !== null
                )
                    ? row.respiratory_rate_bpm - previousRR
                    : null;

            row.protocol_cycle_valid =
                (
                    cycleS !== null &&
                    cycleS > 0
                )
                    ? 1
                    : 0;

            row.cycle_qc =
                newSession
                    ? "session_start"
                    : "protocol_valid";

            if (
                cycleS !== null &&
                cycleS > 0
            ) {

                sessionIntervals[sessionId]
                    .push(cycleS);

                sessionRR[sessionId]
                    .push(
                        row.respiratory_rate_bpm
                    );

                previousCycleS =
                    cycleS;

                previousRR =
                    row.respiratory_rate_bpm;

            }

            const intervals =
                sessionIntervals[sessionId];

            const rr =
                sessionRR[sessionId];

            [3, 5, 10, 21].forEach(
                windowSize => {

                    const x =
                        intervals.slice(
                            -windowSize
                        );

                    const r =
                        rr.slice(
                            -windowSize
                        );

                    const s =
                        intervalStats(x);

                    row[
                        `roll${windowSize}_n`
                    ] =
                        s.n;

                    row[
                        `roll${windowSize}_mean_cycle_s`
                    ] =
                        s.mean;

                    row[
                        `roll${windowSize}_sd_cycle_s`
                    ] =
                        s.sd;

                    row[
                        `roll${windowSize}_cv_cycle_pct`
                    ] =
                        s.cv_pct;

                    row[
                        `roll${windowSize}_rmssd_cycle_s`
                    ] =
                        s.rmssd;

                    row[
                        `roll${windowSize}_mean_rr_bpm`
                    ] =
                        mean(r);

                }
            );

            row.minute_bucket =
                row.datetime
                    ? row.datetime.slice(0, 16)
                    : "";

            row.hour_bucket =
                row.datetime
                    ? row.datetime.slice(0, 13)
                    : "";

            previousBreath =
                row;

        }
    );

    const minuteCounts = {};
    const hourCounts = {};

    breaths.forEach(
        row => {

            minuteCounts[row.minute_bucket] =
                (
                    minuteCounts[row.minute_bucket] ||
                    0
                ) + 1;

            hourCounts[row.hour_bucket] =
                (
                    hourCounts[row.hour_bucket] ||
                    0
                ) + 1;

        }
    );

    breaths.forEach(
        row => {

            row.chant_cycles_in_clock_minute =
                minuteCounts[row.minute_bucket] ||
                0;

            row.chant_cycles_in_clock_hour =
                hourCounts[row.hour_bucket] ||
                0;

        }
    );

    const sessionGroups = {};

    breaths.forEach(
        row => {

            if (!sessionGroups[row.session_id]) {
                sessionGroups[row.session_id] = [];
            }

            sessionGroups[row.session_id]
                .push(row);

        }
    );

    Object.keys(sessionGroups)
        .forEach(
            id => {

                const rows =
                    sessionGroups[id];

                const first = rows[0];
                const last =
                    rows[rows.length - 1];

                const durationS =
                    (
                        last.timestamp_ms -
                        first.timestamp_ms
                    ) / 1000;

                const intervals =
                    rows
                        .map(
                            row =>
                                row.respiratory_cycle_s
                        )
                        .filter(Number.isFinite);

                const rr =
                    rows
                        .map(
                            row =>
                                row.respiratory_rate_bpm
                        )
                        .filter(Number.isFinite);

                const stats =
                    intervalStats(intervals);

                const half =
                    Math.floor(rr.length / 2);

                const firstHalf =
                    rr.slice(0, half);

                const secondHalf =
                    rr.slice(half);

                const rrRows =
                    rows.filter(
                        row =>
                            Number.isFinite(
                                row.respiratory_rate_bpm
                            )
                    );

                const rrForSlope =
                    rrRows.map(
                        row =>
                            row.respiratory_rate_bpm
                    );

                const elapsedMin =
                    rrRows.map(
                        row =>
                            (
                                row.timestamp_ms -
                                first.timestamp_ms
                            ) /
                            60000
                    );

                const rrSlope =
                    linearSlope(
                        rrForSlope,
                        elapsedMin
                    );

                rows.forEach(
                    row => {

                        row.session_start_datetime =
                            first.datetime;

                        row.session_end_datetime =
                            last.datetime;

                        row.session_duration_s =
                            durationS;

                        row.session_duration_min =
                            durationS / 60;

                        row.session_elapsed_s =
                            (
                                row.timestamp_ms -
                                first.timestamp_ms
                            ) / 1000;

                        row.session_total_cycles =
                            rows.length;

                        row.session_mean_cycle_s =
                            stats.mean;

                        row.session_median_cycle_s =
                            stats.median;

                        row.session_sd_cycle_s =
                            stats.sd;

                        row.session_cv_cycle_pct =
                            stats.cv_pct;

                        row.session_rmssd_cycle_s =
                            stats.rmssd;

                        row.session_mean_abs_successive_diff_s =
                            stats.mean_abs_successive_diff;

                        row.session_min_cycle_s =
                            stats.min;

                        row.session_max_cycle_s =
                            stats.max;

                        row.session_iqr_cycle_s =
                            stats.iqr;

                        row.session_mean_rr_bpm =
                            mean(rr);

                        row.session_median_rr_bpm =
                            median(rr);

                        row.session_sd_rr_bpm =
                            sampleSD(rr);

                        row.session_cv_rr_pct =
                            coefficientVariationPct(rr);

                        row.session_first_half_mean_rr_bpm =
                            mean(firstHalf);

                        row.session_second_half_mean_rr_bpm =
                            mean(secondHalf);

                        row.session_rr_change_first_to_second_bpm =
                            (
                                mean(firstHalf) !== null &&
                                mean(secondHalf) !== null
                            )
                                ? mean(secondHalf) -
                                  mean(firstHalf)
                                : null;

                        row.session_rr_slope_bpm_per_min =
                            rrSlope;

                        row.session_chants_per_min =
                            (
                                durationS > 0 &&
                                rows.length > 1
                            )
                                ? (
                                    (
                                        rows.length - 1
                                    ) *
                                    60 /
                                    durationS
                                )
                                : null;

                    }
                );

            }
        );

    const dayGroups = {};

    breaths.forEach(
        row => {

            if (!dayGroups[row.date]) {
                dayGroups[row.date] = [];
            }

            dayGroups[row.date]
                .push(row);

        }
    );

    const dailySummary = {};

    const observedDates =
        Object.keys(dayGroups)
            .sort();

    observedDates.forEach(
        date => {

            const rows =
                dayGroups[date];

            const intervals =
                rows
                    .map(
                        row =>
                            row.respiratory_cycle_s
                    )
                    .filter(Number.isFinite);

            const rr =
                rows
                    .map(
                        row =>
                            row.respiratory_rate_bpm
                    )
                    .filter(Number.isFinite);

            const stats =
                intervalStats(intervals);

            const sessionIds =
                [
                    ...new Set(
                        rows.map(
                            row =>
                                row.session_id
                        )
                    )
                ];

            let activeDurationS =
                0;

            sessionIds.forEach(
                id => {

                    const sRows =
                        sessionGroups[id];

                    if (
                        sRows &&
                        sRows.length > 1
                    ) {

                        activeDurationS +=
                            (
                                sRows[
                                    sRows.length - 1
                                ].timestamp_ms -
                                sRows[0].timestamp_ms
                            ) /
                            1000;

                    }

                }
            );

            dailySummary[date] = {

                day_chant_cycles:
                    rows.length,

                day_respiratory_cycles:
                    rows.length,

                day_sessions:
                    sessionIds.length,

                day_active_duration_min:
                    activeDurationS / 60,

                day_first_cycle_datetime:
                    rows[0].datetime,

                day_last_cycle_datetime:
                    rows[
                        rows.length - 1
                    ].datetime,

                day_mean_cycle_s:
                    stats.mean,

                day_median_cycle_s:
                    stats.median,

                day_sd_cycle_s:
                    stats.sd,

                day_cv_cycle_pct:
                    stats.cv_pct,

                day_rmssd_cycle_s:
                    stats.rmssd,

                day_mean_abs_successive_diff_s:
                    stats.mean_abs_successive_diff,

                day_min_cycle_s:
                    stats.min,

                day_max_cycle_s:
                    stats.max,

                day_iqr_cycle_s:
                    stats.iqr,

                day_mean_rr_bpm:
                    mean(rr),

                day_median_rr_bpm:
                    median(rr),

                day_sd_rr_bpm:
                    sampleSD(rr),

                day_cv_rr_pct:
                    coefficientVariationPct(rr)

            };

        }
    );

    observedDates.forEach(
        (date, index) => {

            const current =
                dailySummary[date];

            current.study_day =
                index + 1;

            const previous =
                index > 0
                    ? dailySummary[
                        observedDates[index - 1]
                    ]
                    : null;

            current.day_change_chant_cycles =
                previous
                    ? current.day_chant_cycles -
                      previous.day_chant_cycles
                    : null;

            current.day_change_mean_rr_bpm =
                (
                    previous &&
                    Number.isFinite(
                        current.day_mean_rr_bpm
                    ) &&
                    Number.isFinite(
                        previous.day_mean_rr_bpm
                    )
                )
                    ? current.day_mean_rr_bpm -
                      previous.day_mean_rr_bpm
                    : null;

            [3, 7, 14].forEach(
                windowSize => {

                    const dates =
                        observedDates.slice(
                            Math.max(
                                0,
                                index - windowSize + 1
                            ),
                            index + 1
                        );

                    const chantValues =
                        dates.map(
                            d =>
                                dailySummary[d]
                                    .day_chant_cycles
                        );

                    const rrValues =
                        dates
                            .map(
                                d =>
                                    dailySummary[d]
                                        .day_mean_rr_bpm
                            )
                            .filter(Number.isFinite);

                    const cycleValues =
                        dates
                            .map(
                                d =>
                                    dailySummary[d]
                                        .day_mean_cycle_s
                            )
                            .filter(Number.isFinite);

                    current[
                        `rolling_${windowSize}d_chant_mean`
                    ] =
                        mean(chantValues);

                    current[
                        `rolling_${windowSize}d_rr_mean_bpm`
                    ] =
                        mean(rrValues);

                    current[
                        `rolling_${windowSize}d_cycle_mean_s`
                    ] =
                        mean(cycleValues);

                }
            );

        }
    );

    breaths.forEach(
        row => {

            const d =
                dailySummary[row.date];

            if (d) {
                Object.assign(row, d);
            }

        }
    );

    allEvents.forEach(
        row => {

            row.is_breath_chant_cycle =
                isRespiratoryEvent(row)
                    ? 1
                    : 0;

            row.action_normalized =
                row.is_breath_chant_cycle
                    ? "breath_chant_cycle"
                    : (row.action || "");

        }
    );

    return allEvents;
}


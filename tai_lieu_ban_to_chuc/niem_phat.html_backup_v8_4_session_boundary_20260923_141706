function reportMean(values) {
    const x = values.filter(Number.isFinite);
    return x.length
        ? x.reduce((a, b) => a + b, 0) / x.length
        : null;
}

function reportMedian(values) {
    const x = values
        .filter(Number.isFinite)
        .slice()
        .sort((a, b) => a - b);

    if (!x.length) return null;

    const m = Math.floor(x.length / 2);

    return x.length % 2
        ? x[m]
        : (x[m - 1] + x[m]) / 2;
}

function reportSD(values) {
    const x = values.filter(Number.isFinite);

    if (x.length < 2) return null;

    const m = reportMean(x);

    return Math.sqrt(
        x.reduce(
            (s, v) => s + (v - m) ** 2,
            0
        ) /
        (x.length - 1)
    );
}

function reportRMSSD(values) {
    const x = values.filter(Number.isFinite);

    if (x.length < 2) return null;

    const d2 = [];

    for (let i = 1; i < x.length; i++) {
        const d = x[i] - x[i - 1];
        d2.push(d * d);
    }

    return Math.sqrt(reportMean(d2));
}

function reportFmt(value, digits = 1) {
    if (!Number.isFinite(Number(value))) {
        return "—";
    }

    return Number(value)
        .toLocaleString(
            "vi-VN",
            {
                minimumFractionDigits: digits,
                maximumFractionDigits: digits
            }
        );
}

function reportInt(value) {
    if (!Number.isFinite(Number(value))) {
        return "0";
    }

    return Math.round(Number(value))
        .toLocaleString("vi-VN");
}

function reportSlope(y, x) {

    if (
        y.length !== x.length ||
        y.length < 3
    ) {
        return null;
    }

    const xm = reportMean(x);
    const ym = reportMean(y);

    let num = 0;
    let den = 0;

    for (let i = 0; i < y.length; i++) {

        num +=
            (x[i] - xm) *
            (y[i] - ym);

        den +=
            (x[i] - xm) ** 2;
    }

    return den === 0
        ? null
        : num / den;
}

// ------------------------------------------------------------
// Small SVG sparkline
// ------------------------------------------------------------

function reportSparkline(values) {

    const x = values
        .map(Number)
        .filter(Number.isFinite);

    if (!x.length) {
        return "";
    }

    const width = 520;
    const height = 90;
    const pad = 8;

    const min = Math.min(...x);
    const max = Math.max(...x);

    const range =
        max - min || 1;

    const points = x
        .map(
            (v, i) => {

                const px =
                    x.length === 1
                        ? width / 2
                        : pad +
                          i *
                          (width - pad * 2) /
                          (x.length - 1);

                const py =
                    height - pad -
                    (v - min) /
                    range *
                    (height - pad * 2);

                return `${px},${py}`;
            }
        )
        .join(" ");

    return `
        <svg viewBox="0 0 ${width} ${height}"
             width="100%"
             height="70"
             role="img"
             aria-label="Xu hướng số niệm">
            <line
                x1="0"
                y1="${height - 8}"
                x2="${width}"
                y2="${height - 8}"
                stroke="#eadfce"
                stroke-width="1"
            />
            <polyline
                fill="none"
                stroke="#b96d08"
                stroke-width="4"
                stroke-linecap="round"
                stroke-linejoin="round"
                points="${points}"
            />
        </svg>
    `;
}


        .stats {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 8px;
            padding-top: 20px;
            border-top: 1px solid var(--border);
        }

        .stat {
            padding: 7px 2px;
        }

        .stat-value {
            font-size: 1.15rem;
            font-weight: 700;
        }

        .stat-label {
            color: var(--secondary);
            font-size: 0.72rem;
            margin-top: 4px;
        }

        .controls {
            display: grid;
            grid-template-columns: repeat(3,1fr);
            gap: 8px;
            margin-top: 18px;
        }

        button {
            font-family: inherit;
        }

        .small-button {
            border: none;
            background: #f1e9dd;
            color: var(--text);
            padding: 12px 5px;
            border-radius: 13px;
            font-size: 0.85rem;
            font-weight: 600;
            cursor: pointer;
        }

        .small-button:active {
            transform: scale(0.96);
        }

        .export-button {
            width: 100%;
            margin-top: 12px;
            border: none;
            background: var(--primary);
            color: white;
            padding: 13px;
            border-radius: 13px;
            font-size: 0.9rem;
            font-weight: 650;
            cursor: pointer;
        }

        .export-button:active {
            transform: scale(0.98);
        }

        .reset {
            width: 100%;
            margin-top: 10px;
            border: none;
            background: #f6e6e3;
            color: var(--danger);
            padding: 12px;
            border-radius: 13px;
            font-size: 0.85rem;
            font-weight: 600;
            cursor: pointer;
        }

        .reset:active {
            transform: scale(0.98);
        }

        .footer {
            margin-top: 20px;
            font-size: 0.75rem;
            color: #a19689;
        }

        /* ================================================ */

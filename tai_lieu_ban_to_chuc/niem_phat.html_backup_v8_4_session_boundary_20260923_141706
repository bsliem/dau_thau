                r =>
                    Number(
                        r.clean_respiratory_rate_bpm
                    )
            );

            const slope =
                reportSlope(yy, xx);

            if (Number.isFinite(slope)) {

                if (slope < -0.3) {
                    rrTrendText =
                        "Nhịp có xu hướng chậm dần trong phiên gần nhất";

                } else if (slope > 0.3) {

                        "Nhịp có xu hướng nhanh dần trong phiên gần nhất";

                } else {
                    rrTrendText =
                        "Nhịp tương đối ổn định trong phiên gần nhất";
                }
            }
        }
    }

// ------------------------------------------------------------
// Interpretation
// ------------------------------------------------------------

    let practiceText =
        `${trendText}. ` +
        `Dòng niệm duy trì ${
            Number.isFinite(continuity)
                ? reportFmt(continuity, 1) + '%'
                : 'chưa đủ dữ liệu'
        }.`;

    if (missed > 0) {
        practiceText +=
            ` Ghi nhận ${missed} khoảng nghi gián đoạn dòng niệm.`;
    }

// ------------------------------------------------------------
// Sparkline
// ------------------------------------------------------------

    const spark =
        reportSparkline(
            historyEntries
                .slice(-14)
                .map(d => d.count)
        );

    const generated =
        new Date()
            .toLocaleString("vi-VN");

// ------------------------------------------------------------

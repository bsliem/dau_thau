<script>

"use strict";

// ============================================================
// CONFIG
// ============================================================

const APP_VERSION = "v8_3_live_session_fix";
const ROUND_TARGET = 21;
const SESSION_BREAK_CYCLES = 10;
const SESSION_FALLBACK_GAP_S = 25;
const SESSION_LOCAL_WINDOW = 7;
const STORAGE_KEY = "niem_phat_data_v6";

const OLD_STORAGE_KEYS = [
    "niem_phat_data_v5_research",
    "niem_phat_data_v4",
    "niem_phat_data_v3",
    "niem_phat_data_v2",
    "niem_phat_data_v1"
];

// ============================================================
// RESEARCH PROTOCOL
// ============================================================

const PROTOCOL_ID = "nam_mo_a_mi_tuo_fo_phase_marker_v1";
const CHANT_PHRASE = "南無阿彌陀佛";
const INSPIRATION_PHRASE = "南無";
const TRANSITION_PHRASE = "阿";
const EXPIRATION_PHRASE = "彌陀佛";
const TAP_PHASE = "inspiration_to_expiration_transition";
const CYCLE_DEFINITION = "interval_between_two_consecutive_same_phase_taps";
const MEASUREMENT_TYPE = "self_timed_phase_locked_respiration_chant";

// ============================================================
// DATA
// ============================================================

let data = {
    date: "",
    today: 0,
    total: 0,
    history: {},
    events: []
};

// ============================================================
// ELEMENTS
// ============================================================

const counterEl = document.getElementById("counter");

const currentSessionCountEl = document.getElementById("currentSessionCount");
const currentSessionRateEl = document.getElementById("currentSessionRate");
const currentClockEl = document.getElementById("currentClock");
const currentSessionDurationEl = document.getElementById("currentSessionDuration");
const todayCountEl = document.getElementById("todayCount");
const totalCountEl = document.getElementById("totalCount");
const roundCountEl = document.getElementById("roundCount");
const progressTextEl = document.getElementById("progressText");
const progressBarEl = document.getElementById("progressBar");
const mainButton = document.getElementById("mainButton");
const undoButton = document.getElementById("undoButton");
const plus7Button = document.getElementById("plus7Button");
const plus21Button = document.getElementById("plus21Button");
const exportButton = document.getElementById("exportButton");
const reportButton = document.getElementById("reportButton");
const resetButton = document.getElementById("resetButton");

// ============================================================
// HELPERS
// ============================================================

function pad2(value) {
    return String(value).padStart(2, "0");
}

function roundN(value, digits = 6) {

    if (
        value === null ||
        value === undefined ||
        !Number.isFinite(Number(value))
    ) {
        return "";
    }

    const factor = 10 ** digits;

    return Math.round(Number(value) * factor) / factor;
}

function mean(values) {

    const x = values.filter(Number.isFinite);

    if (!x.length) {
        return null;
    }

    return x.reduce((a, b) => a + b, 0) / x.length;
}

function median(values) {

    const x = values
        .filter(Number.isFinite)
        .slice()
        .sort((a, b) => a - b);

    if (!x.length) {
        return null;
    }

    const mid = Math.floor(x.length / 2);

    if (x.length % 2 === 1) {
        return x[mid];
    }

    return (x[mid - 1] + x[mid]) / 2;
}

function sampleSD(values) {

    const x = values.filter(Number.isFinite);

    if (x.length < 2) {
        return null;
    }

    const m = mean(x);

    const variance =
        x.reduce(
            (sum, value) => sum + (value - m) ** 2,
            0
        ) /
        (x.length - 1);

    return Math.sqrt(variance);
}

function coefficientVariationPct(values) {

    const m = mean(values);
    const sd = sampleSD(values);

    if (
        m === null ||
        sd === null ||
        m === 0
    ) {
        return null;
    }

    return sd / m * 100;
}

function rmssd(values) {

    const x = values.filter(Number.isFinite);

    if (x.length < 2) {
        return null;
    }

    const diffs = [];

    for (let i = 1; i < x.length; i++) {
        const d = x[i] - x[i - 1];
        diffs.push(d * d);
    }

    return Math.sqrt(mean(diffs));
}

function meanAbsoluteSuccessiveDifference(values) {

    const x = values.filter(Number.isFinite);

    if (x.length < 2) {
        return null;
    }

    const diffs = [];

    for (let i = 1; i < x.length; i++) {
        diffs.push(Math.abs(x[i] - x[i - 1]));
    }

    return mean(diffs);
}

function quantile(values, q) {

    const x = values
        .filter(Number.isFinite)
        .slice()
        .sort((a, b) => a - b);

    if (!x.length) {
        return null;
    }

    if (x.length === 1) {
        return x[0];
    }

    const position = (x.length - 1) * q;
    const lower = Math.floor(position);
    const fraction = position - lower;

    if (x[lower + 1] !== undefined) {
        return x[lower] + fraction * (x[lower + 1] - x[lower]);
    }

    return x[lower];
}

function linearSlope(yValues, xValues) {

    if (
        yValues.length !== xValues.length ||
        yValues.length < 2
    ) {
        return null;
    }

    const xMean = mean(xValues);
    const yMean = mean(yValues);

    let numerator = 0;
    let denominator = 0;

    for (let i = 0; i < yValues.length; i++) {

        numerator +=
            (xValues[i] - xMean) *
            (yValues[i] - yMean);

        denominator +=
            (xValues[i] - xMean) ** 2;

    }

    if (denominator === 0) {
        return null;
    }

    return numerator / denominator;
}

// ============================================================
// DATE / TIME
// ============================================================

function getDateParts(date = new Date()) {

    const year = date.getFullYear();
    const month = pad2(date.getMonth() + 1);
    const day = pad2(date.getDate());
    const hour = pad2(date.getHours());
    const minute = pad2(date.getMinutes());
    const second = pad2(date.getSeconds());

    return {
        date: `${year}-${month}-${day}`,
        time: `${hour}:${minute}:${second}`,
        datetime: `${year}-${month}-${day} ${hour}:${minute}:${second}`,
        timestamp_ms: date.getTime(),
        timezone_offset_min: -date.getTimezoneOffset(),
        hour: Number(hour),
        minute: Number(minute),
        second: Number(second),
        weekday_num: date.getDay()
    };
}

function getToday() {
    return getDateParts().date;
}

function getWeekdayEnglish(day) {

    const names = [
        "Sun",
        "Mon",
        "Tue",
        "Wed",
        "Thu",
        "Fri",
        "Sat"
    ];

    return names[day] || "";
}

function getTimeOfDay(hour) {

    if (hour < 6) return "night";
    if (hour < 12) return "morning";
    if (hour < 18) return "afternoon";
    return "evening";
}

// ============================================================
// MIGRATION
// ============================================================

function migrateOldData() {

    for (const key of OLD_STORAGE_KEYS) {

        try {

            const saved = localStorage.getItem(key);

            if (!saved) {
                continue;
            }

            const oldData = JSON.parse(saved);

            return {
                date: oldData.date || getToday(),
                today: Number(oldData.today) || 0,
                total: Number(oldData.total) || 0,
                history: oldData.history || {},
                events: Array.isArray(oldData.events)
                    ? oldData.events
                    : []
            };

        } catch (error) {

            console.log("migration_error", key, error);

        }
    }

    return null;
}

// ============================================================
// LOAD
// ============================================================

function loadData() {

    const today = getToday();

    data = {
        date: today,
        today: 0,
        total: 0,
        history: {},
        events: []
    };

    try {

        const saved = localStorage.getItem(STORAGE_KEY);

        if (saved) {

            const loaded = JSON.parse(saved);

            data = {
                date: loaded.date || today,
                today: Number(loaded.today) || 0,
                total: Number(loaded.total) || 0,
                history: loaded.history || {},
                events: Array.isArray(loaded.events)
                    ? loaded.events
                    : []
            };

        } else {

            const migrated = migrateOldData();

            if (migrated) {
                data = migrated;
                saveData();
            }
        }

    } catch (error) {

        console.error("load_error", error);

    }

    if (data.date !== today) {

        if (data.date) {
            data.history[data.date] = data.today;
        }

        data.date = today;
        data.today = 0;

        saveData();
    }
}

// ============================================================
// SAVE
// ============================================================

function saveData() {

    data.date = getToday();
    data.history[data.date] = data.today;

    try {

        localStorage.setItem(
            STORAGE_KEY,
            JSON.stringify(data)
        );

    } catch (error) {

        console.error("save_error", error);

    }
}

// ============================================================
// RAW EVENT
// ============================================================

function logEvent(
    action,
    amount,
    isRespiratoryCycle
) {

    const now = getDateParts();

    data.events.push({

        event_id: `${now.timestamp_ms}_${data.events.length + 1}`,

        app_version: APP_VERSION,
        protocol_id: PROTOCOL_ID,
        measurement_type: MEASUREMENT_TYPE,

        chant_phrase: CHANT_PHRASE,
        inspiration_phrase: INSPIRATION_PHRASE,
        transition_phrase: TRANSITION_PHRASE,
        expiration_phrase: EXPIRATION_PHRASE,

        tap_phase: TAP_PHASE,
        cycle_definition: CYCLE_DEFINITION,

        date: now.date,
        time: now.time,
        datetime: now.datetime,
        timestamp_ms: now.timestamp_ms,
        timezone_offset_min: now.timezone_offset_min,

        weekday: getWeekdayEnglish(now.weekday_num),
        weekday_num: now.weekday_num,

        hour: now.hour,
        minute: now.minute,
        second: now.second,

        time_of_day: getTimeOfDay(now.hour),

        action: action,
        amount: amount,

        is_respiratory_cycle:
            isRespiratoryCycle ? 1 : 0,

        protocol_valid:
            isRespiratoryCycle ? 1 : 0,

        voided: false,

        daily_chant_total: data.today,
        grand_chant_total: data.total,

        rounds_21:
            Math.floor(
                data.today /
                ROUND_TARGET
            ),

        position_21:
            data.today %
            ROUND_TARGET,

        page_visibility:
            document.visibilityState || ""

    });
}


// ============================================================
// DYNAMIC SESSION
// New session after missing about 10 expected chant cycles
// ============================================================

function getDynamicSessionThreshold(intervals = []) {

    const recent = intervals
        .filter(
            value =>
                Number.isFinite(Number(value)) &&
                Number(value) > 0
        )
        .map(Number)
        .slice(-SESSION_LOCAL_WINDOW);

    if (recent.length >= 3) {

        const localMedian =
            median(recent);

        if (
            Number.isFinite(localMedian) &&
            localMedian > 0
        ) {

            return
                localMedian *
                SESSION_BREAK_CYCLES;
        }
    }

    return SESSION_FALLBACK_GAP_S;
}

// ============================================================
// CLOCK HELPERS
// ============================================================

function formatClockTime(date = new Date()) {

    return [
        pad2(date.getHours()),
        pad2(date.getMinutes()),
        pad2(date.getSeconds())
    ].join(":");
}

function formatSessionDuration(seconds) {

    if (
        !Number.isFinite(seconds) ||
        seconds < 0
    ) {
        return "00:00";
    }

    const total =
        Math.floor(seconds);

    const hours =
        Math.floor(total / 3600);

    const minutes =
        Math.floor(
            (total % 3600) / 60
        );

    const secondsPart =
        total % 60;

    if (hours > 0) {

        return [
            pad2(hours),
            pad2(minutes),
            pad2(secondsPart)
        ].join(":");
    }

    return [
        pad2(minutes),
        pad2(secondsPart)
    ].join(":");
}

// ============================================================
// GET CURRENT LIVE SESSION
// ============================================================

function getCurrentLiveSession() {

    const today = getToday();

    const events = data.events
        .filter(
            event =>
                event.voided !== true &&
                event.date === today &&
                (
                    event.action === "breath_chant_cycle" ||
                    event.action === "breath"
                ) &&
                Number(event.amount) === 1
        )
        .map(
            event => ({
                ...event,
                timestamp_ms:
                    Number(
                        event.timestamp_ms ??
                        event.timestamp
                    )
            })
        )
        .filter(
            event =>
                Number.isFinite(
                    event.timestamp_ms
                )
        )
        .sort(
            (a, b) =>
                a.timestamp_ms -
                b.timestamp_ms
        );

    if (!events.length) {

        return {
            active: false,
            count: 0,
            rate: null,
            elapsed_s: 0,
            threshold_s:
                SESSION_FALLBACK_GAP_S
        };
    }

    let current = [];
    let intervals = [];

    for (const event of events) {

        if (!current.length) {

            current = [event];
            intervals = [];
            continue;
        }

        const previous =
            current[current.length - 1];

        const gap =
            (
                event.timestamp_ms -
                previous.timestamp_ms
            ) / 1000;

        const threshold =
            getDynamicSessionThreshold(
                intervals
            );

        if (gap >= threshold) {

            // New session
            current = [event];
            intervals = [];

        } else {

            current.push(event);

            if (gap > 0) {
                intervals.push(gap);
            }
        }
    }

    const first = current[0];

    const last =
        current[current.length - 1];

    const threshold =
        getDynamicSessionThreshold(
            intervals
        );

    const nowMs = Date.now();

    const idleS =
        (
            nowMs -
            last.timestamp_ms
        ) / 1000;

    // --------------------------------------------------------
    // SESSION EXPIRED
    // --------------------------------------------------------

    if (idleS >= threshold) {

        return {
            active: false,
            count: 0,
            rate: null,
            elapsed_s: 0,
            idle_s: idleS,
            threshold_s: threshold
        };
    }

    // --------------------------------------------------------
    // ACTIVE SESSION
    // --------------------------------------------------------

    const elapsedS =
        (
            nowMs -
            first.timestamp_ms
        ) / 1000;

    const observedDurationS =
        current.length > 1
            ? (
                last.timestamp_ms -
                first.timestamp_ms
              ) / 1000
            : 0;

    const rate =
        current.length > 1 &&
        observedDurationS > 0
            ? (
                current.length - 1
              ) *
              60 /
              observedDurationS
            : null;

    return {
        active: true,
        count: current.length,
        rate: rate,
        elapsed_s: elapsedS,
        idle_s: idleS,
        threshold_s: threshold
    };
}


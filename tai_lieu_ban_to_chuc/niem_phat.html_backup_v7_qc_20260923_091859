function csvCell(value) {

    if (
        value === null ||
        value === undefined
    ) {
        return "";
    }

    let text =
        String(value);

    if (
        text.includes(",") ||
        text.includes('"') ||
        text.includes("\n")
    ) {

        text =
            '"' +
            text.replace(
                /"/g,
                '""'
            ) +
            '"';

    }

    return text;
}


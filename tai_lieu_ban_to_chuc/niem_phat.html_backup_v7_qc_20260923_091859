function buildCSV() {

    const rows =
        buildResearchRows();

    let csv =
        "\uFEFF" +
        CSV_COLUMNS.join(",") +
        "\n";

    rows.forEach(
        row => {

            const values =
                CSV_COLUMNS.map(
                    column => {

                        const value =
                            row[column];

                        if (
                            typeof value ===
                                "number" &&
                            column !==
                                "timestamp_ms"
                        ) {

                            return roundN(
                                value,
                                6
                            );

                        }

                        return value ?? "";

                    }
                );

            csv +=
                values
                    .map(csvCell)
                    .join(",") +
                "\n";

        }
    );

    return csv;
}

